generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecipeStatus {
  ACTIVE
  ARCHIVED
}

model Recipe {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  description String?
  author      String?
  servings    Int?
  difficulty  String?
  notes       String?
  status      RecipeStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  archivedAt  DateTime?          @map("archived_at")
  steps       RecipeStep[]
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeStep {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  position Int
  text     String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@map("recipe_steps")
}

model Ingredient {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String              @unique @map("normalized_name")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  variants       IngredientVariant[]
  recipeUses     RecipeIngredient[]

  @@map("ingredients")
}

model IngredientVariant {
  id             String             @id @default(uuid()) @db.Uuid
  ingredientId   String             @map("ingredient_id") @db.Uuid
  name           String
  normalizedName String             @map("normalized_name")
  ingredient     Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  recipeUses     RecipeIngredient[] @relation("RecipeIngredientVariant")

  @@unique([ingredientId, normalizedName])
  @@unique([id, ingredientId])
  @@map("ingredient_variants")
}

model Unit {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  abbreviation   String
  normalizedName String             @unique @map("normalized_name")
  recipeUses     RecipeIngredient[]

  @@map("units")
}

model RecipeIngredient {
  id            String             @id @default(uuid()) @db.Uuid
  recipeId      String             @map("recipe_id") @db.Uuid
  ingredientId  String             @map("ingredient_id") @db.Uuid
  variantId     String?            @map("variant_id") @db.Uuid
  quantity      Decimal?           @db.Decimal(12, 3)
  unitId        String?            @map("unit_id") @db.Uuid
  optional      Boolean            @default(false)
  observations  String?
  position      Int
  recipe        Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  variant       IngredientVariant? @relation("RecipeIngredientVariant", fields: [variantId, ingredientId], references: [id, ingredientId], onDelete: Restrict)
  unit          Unit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([recipeId, position])
  @@index([variantId, ingredientId])
  @@map("recipe_ingredients")
}
